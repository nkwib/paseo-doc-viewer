  "description": "Read PDFs and Office documents, inspect spreadsheets and data, and send PDF page notes to an agent without leaving Paseo.",
  "license": "MIT",
  "type": "module",
  "files": [
    "paseo-plugin.json",
    "OVERVIEW.md",
    "NOTICE",
    "LICENSE",
    "assets/",
    "index.client.ts",
    "index.client.tsx",
    "index.server.ts",
    "index.server.tsx",
    "client/",
    "server/",
    "shared/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p test/browser/tsconfig.json",
    "test": "vitest run --dir test",
