    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.2.0",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "paseo-plugin-devkit": "0.1.0",
    "pdf-lib": "^1.17.1",
    "react": "19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
